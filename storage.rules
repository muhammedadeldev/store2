rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read for product and banner images
      allow read: if true;
      // Allow write only if admin
      allow write: if request.auth != null && (
        request.auth.token.email == 'mohamedqwe542@gmail.com'
      );
    }
  }
}
