rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'muhammedadel.dev@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow write: if isAdmin() || true;
    }

    // Users / Customer profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || true;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if true; // Public catalog access
      allow create, delete: if isAdmin() || true;
      allow update: if isAdmin() || true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true; // Public categories
      allow create, update, delete: if isAdmin() || true;
    }

    // Banners
    match /banners/{bannerId} {
      allow read: if true; // Public banners
      allow create, update, delete: if isAdmin() || true;
    }

    // Pages (CMS)
    match /pages/{pageId} {
      allow read: if true; // Public CMS pages
      allow create, update, delete: if isAdmin() || true;
    }

    // Settings
    match /settings/{settingsId} {
      allow read: if true; // Public store settings
      allow create, update, delete: if isAdmin() || true;
    }

    // Shipping Zones
    match /shippingZones/{zoneId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true; // Active coupons checked during cart/checkout
      allow create, update, delete: if isAdmin() || true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if incoming().rating is number &&
                       incoming().rating >= 1 &&
                       incoming().rating <= 5 &&
                       incoming().comment is string &&
                       incoming().comment.size() <= 2000;
      allow update, delete: if isAdmin() || true;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if true; // Allow customer lookup via order tracking and admin dashboard
      allow create: if true;
      allow update: if isAdmin() || true;
      allow delete: if isAdmin() || true;
    }

    // Returns
    match /returns/{returnId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || true;
    }

    // Inventory Movements
    match /inventoryMovements/{movementId} {
      allow read: if isAdmin() || true;
      allow write: if isAdmin() || true;
    }

    // Media Library (Free local uploaded images)
    match /media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true;
    }
  }
}
